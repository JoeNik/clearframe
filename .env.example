# 对外端口
PORT=8080

# 容器时区
TZ=Asia/Shanghai

# 首次启动创建的管理员账号
ADMIN_USER=admin
# 不填则使用内置默认密码（首次启动日志会打印并提醒修改）；公网部署建议显式设置强密码
# （账号创建后再改这里不影响已有密码，请登录后在「账号」页修改）
ADMIN_PASSWORD=

# 部署在 Nginx / CDN / 反向代理之后时改为 1
TRUST_PROXY=0

# 「抖音作者作品分析」旁挂数据服务地址（Douyin_TikTok_Download_API）
# docker compose 部署默认 http://douyin-api:80（同网络内容器），无需修改；
# 手动部署时填实际地址，留空则该能力提示未配置。后台「全局设置」里也可改。
#DOUYIN_SIDECAR=http://douyin-api:80
# 旁挂服务开启了 API Key 鉴权时才需要
#DOUYIN_SIDECAR_KEY=
